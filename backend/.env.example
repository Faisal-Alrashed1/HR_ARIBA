# development | test | production
ENV=development

# SQLite for quick local work; the Supabase Postgres connection string otherwise
# (Supabase dashboard -> Project Settings -> Database -> Connection string, "Session pooler").
DATABASE_URL=sqlite:///./dev.db
RUN_MIGRATIONS_ON_STARTUP=true

# Supabase (leave empty to use dev-only local auth, development only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret. Required for local dev auth (any long random string);
# optional with Supabase (new projects use asymmetric keys via JWKS).
SUPABASE_JWT_SECRET=

INTERNAL_EMAIL_DOMAIN=users.ariba-hr.internal
STORAGE_BUCKET=hr-private
CORS_ORIGINS=http://localhost:3000

# Optional: Supabase *test* project, enables the Postgres migration/RLS test.
# TEST_DATABASE_URL=postgresql://...
